<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.alejandro.synclife.controller.ReviewController"
            styleClass="page">
    <top>
        <VBox spacing="12">
            <BorderPane.margin><Insets bottom="12"/></BorderPane.margin>
            <HBox styleClass="page-header" spacing="8">
                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label text="Revisión semanal" styleClass="title-2"/>
                    <Label fx:id="subtitle" styleClass="text-muted" wrapText="true"/>
                </VBox>
                <HBox fx:id="weekChoiceBox" minWidth="-Infinity"/>
            </HBox>
            <!-- Pasos del asistente: se puede saltar a cualquiera -->
            <HBox fx:id="stepBar" styleClass="step-bar" spacing="6"/>
            <Label fx:id="stepHint" styleClass="step-hint" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="16">
            <VBox spacing="12" HBox.hgrow="ALWAYS" minWidth="0">
                <StackPane fx:id="stepHost" VBox.vgrow="ALWAYS"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="backButton" text="Anterior" onAction="#previous" minWidth="-Infinity">
                        <graphic><FontIcon iconLiteral="mdi2a-arrow-left"/></graphic>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="nextButton" onAction="#next" styleClass="accent" minWidth="-Infinity"/>
                </HBox>
            </VBox>
            <VBox styleClass="panel" spacing="8" prefWidth="240" minWidth="200">
                <Label text="Historial" styleClass="title-4"/>
                <Label text="Pulsa una para verla o retomarla." styleClass="text-muted, text-small" wrapText="true"/>
                <ListView fx:id="historyList" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>

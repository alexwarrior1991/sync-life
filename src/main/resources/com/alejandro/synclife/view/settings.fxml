<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.alejandro.synclife.controller.SettingsController"
            id="settings-page" fitToWidth="true" styleClass="edge-to-edge">
    <VBox styleClass="page" spacing="16">
        <Label text="Ajustes" styleClass="title-2"/>

        <VBox styleClass="panel" spacing="10" maxWidth="760">
            <Label text="Apariencia" styleClass="title-4"/>
            <HBox spacing="20">
                <RadioButton fx:id="lightRadio" text="Claro">
                    <graphic><FontIcon iconLiteral="mdi2w-white-balance-sunny"/></graphic>
                </RadioButton>
                <RadioButton fx:id="darkRadio" text="Oscuro">
                    <graphic><FontIcon iconLiteral="mdi2w-weather-night"/></graphic>
                </RadioButton>
            </HBox>
        </VBox>

        <VBox styleClass="panel" spacing="10" maxWidth="760">
            <Label text="Rutinas" styleClass="title-4"/>
            <HBox spacing="8" styleClass="settings-row">
                <Label text="Generar las tareas de las rutinas con"/>
                <Spinner fx:id="horizonSpinner" editable="true" prefWidth="90"/>
                <Label text="días de antelación"/>
                <Button text="Aplicar" onAction="#applyHorizon"/>
            </HBox>
            <Label text="Así aparecen en la vista Semana y puedes planificar alrededor de ellas. Nunca se generan días pasados."
                   styleClass="text-muted, text-small" wrapText="true"/>
        </VBox>

        <VBox styleClass="panel" spacing="10" maxWidth="760">
            <Label text="Pomodoro" styleClass="title-4"/>
            <FlowPane hgap="24" vgap="8">
                <HBox spacing="8" styleClass="settings-row">
                    <Label text="Enfoque" minWidth="-Infinity"/>
                    <Spinner fx:id="focusSpinner" editable="true" prefWidth="90"/>
                    <Label text="min" minWidth="-Infinity"/>
                </HBox>
                <HBox spacing="8" styleClass="settings-row">
                    <Label text="Descanso" minWidth="-Infinity"/>
                    <Spinner fx:id="shortBreakSpinner" editable="true" prefWidth="90"/>
                    <Label text="min" minWidth="-Infinity"/>
                </HBox>
                <HBox spacing="8" styleClass="settings-row">
                    <Label text="Descanso largo" minWidth="-Infinity"/>
                    <Spinner fx:id="longBreakSpinner" editable="true" prefWidth="90"/>
                    <Label text="min, cada" minWidth="-Infinity"/>
                    <Spinner fx:id="everySpinner" editable="true" prefWidth="80"/>
                    <Label text="pomodoros" minWidth="-Infinity"/>
                </HBox>
            </FlowPane>
            <HBox spacing="20">
                <CheckBox fx:id="autoBreakCheck" text="Empezar los descansos automáticamente"/>
                <CheckBox fx:id="soundCheck" text="Sonido al terminar cada fase"/>
            </HBox>
            <Label text="Inicia un pomodoro con clic derecho sobre una tarea → «Iniciar pomodoro», o desde su editor. El tiempo de enfoque se guarda como tiempo real de la tarea y se compara con lo estimado en Estadísticas."
                   styleClass="text-muted, text-small" wrapText="true"/>
        </VBox>

        <VBox styleClass="panel" spacing="10" maxWidth="760">
            <Label text="Notificaciones" styleClass="title-4"/>
            <CheckBox fx:id="trayCheck" text="Al cerrar la ventana, seguir en la bandeja del sistema"/>
            <Label fx:id="trayHint" styleClass="text-muted, text-small" wrapText="true"/>
            <CheckBox fx:id="systemNotificationsCheck" text="Avisar también con notificaciones del sistema (si la ventana no está a la vista)"/>
            <CheckBox fx:id="reminderSoundCheck" text="Sonido con cada recordatorio"/>
            <HBox spacing="8" styleClass="settings-row">
                <Label text="Recordatorio para las tareas nuevas:" minWidth="-Infinity"/>
                <ComboBox fx:id="defaultReminderCombo" prefWidth="200"/>
            </HBox>
            <Label text="Los recordatorios se eligen en el editor de cada tarea (y en cada rutina). SyncLife los comprueba cada 30 segundos mientras está abierta, también desde la bandeja."
                   styleClass="text-muted, text-small" wrapText="true"/>
        </VBox>

        <VBox styleClass="panel" spacing="10" maxWidth="760">
            <Label text="Datos" styleClass="title-4"/>
            <HBox spacing="8" styleClass="settings-row">
                <Label text="Carpeta de datos:" minWidth="-Infinity"/>
                <Label fx:id="dataDirLabel" wrapText="true"/>
            </HBox>
            <HBox spacing="8">
                <Button text="Abrir carpeta" onAction="#openDataDir">
                    <graphic><FontIcon iconLiteral="mdi2f-folder-open-outline"/></graphic>
                </Button>
                <Button text="Copia de seguridad…" onAction="#backup">
                    <graphic><FontIcon iconLiteral="mdi2d-database-export-outline"/></graphic>
                </Button>
                <Button text="Cargar datos de ejemplo" onAction="#loadDemo" styleClass="flat"/>
            </HBox>
            <Label text="Todo se guarda en un único fichero SQLite (synclife.db). Para trasladarlo a otro equipo, copia la carpeta o usa la copia de seguridad."
                   styleClass="text-muted, text-small" wrapText="true"/>
            <HBox spacing="8">
                <Button text="Exportar tareas (CSV)…" onAction="#exportCsv">
                    <graphic><FontIcon iconLiteral="mdi2f-file-export-outline"/></graphic>
                </Button>
                <Button text="Importar CSV…" onAction="#importCsv">
                    <graphic><FontIcon iconLiteral="mdi2f-file-import-outline"/></graphic>
                </Button>
            </HBox>
            <Label text="El CSV se abre con Excel o LibreOffice. Al importar verás antes qué se va a crear; solo se añaden tareas, nunca se modifican ni borran las que tienes. Para exportar solo una parte, usa «Exportar» en Tareas con los filtros que quieras."
                   styleClass="text-muted, text-small" wrapText="true"/>
            <Separator/>
            <HBox spacing="8">
                <Button id="reset-data" text="Borrar todos los datos…" onAction="#resetData"
                        styleClass="danger, button-outlined">
                    <graphic><FontIcon iconLiteral="mdi2d-delete-forever-outline"/></graphic>
                </Button>
            </HBox>
            <Label text="Deja SyncLife como recién instalada: borra tareas, rutinas, objetivos y revisiones, y vuelven las categorías de serie. Antes guarda una copia de todo en la carpeta «copias» de la carpeta de datos. Los ajustes de esta pantalla se conservan."
                   styleClass="text-muted, text-small" wrapText="true"/>
        </VBox>

        <VBox styleClass="panel" spacing="6" maxWidth="760">
            <Label text="Acerca de" styleClass="title-4"/>
            <Label fx:id="versionLabel"/>
            <Label fx:id="runtimeLabel" styleClass="text-muted, text-small"/>
        </VBox>
    </VBox>
</ScrollPane>

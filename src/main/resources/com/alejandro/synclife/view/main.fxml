<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Raíz en capas: la ventana normal y, encima, la capa transparente de avisos -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.alejandro.synclife.controller.MainController"
           styleClass="main-root">
    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="220" minWidth="200">
                <HBox styleClass="brand">
                    <FontIcon iconLiteral="mdi2s-sync" styleClass="brand-icon"/>
                    <Label text="SyncLife" styleClass="brand-title"/>
                </HBox>
                <Label fx:id="todayLabel" styleClass="sidebar-date" wrapText="true"/>
                <!-- La navegación se desplaza si la ventana es baja; el Pomodoro queda siempre a la vista -->
                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="sidebar-scroll"
                            VBox.vgrow="ALWAYS">
                    <VBox styleClass="nav-box">
                        <VBox fx:id="primaryNav" styleClass="nav"/>
                        <Region VBox.vgrow="ALWAYS" minHeight="12"/>
                        <VBox fx:id="secondaryNav" styleClass="nav"/>
                    </VBox>
                </ScrollPane>
                <VBox fx:id="pomodoroHost"/>
                <Label text="Ctrl+N nueva tarea · F5 actualizar" styleClass="sidebar-hint" wrapText="true"/>
            </VBox>
        </left>
        <center>
            <StackPane fx:id="contentHost" styleClass="content-host"/>
        </center>
    </BorderPane>
    <VBox fx:id="toastLayer" styleClass="toast-layer" spacing="8"
          StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity"/>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.alejandro.synclife.controller.GoalsController"
            styleClass="page">
    <top>
        <VBox spacing="12">
            <BorderPane.margin><Insets bottom="12"/></BorderPane.margin>
            <HBox styleClass="page-header" spacing="8">
                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label text="Objetivos" styleClass="title-2"/>
                    <Label fx:id="subtitle" styleClass="text-muted" wrapText="true"/>
                </VBox>
                <Button text="Nuevo objetivo" onAction="#newGoal" styleClass="accent" minWidth="-Infinity">
                    <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
                </Button>
            </HBox>
            <HBox styleClass="week-toolbar" spacing="12">
                <HBox fx:id="areaFilterBox"/>
                <CheckBox fx:id="showClosed" text="Mostrar conseguidos y abandonados"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.38" styleClass="routines-split">
            <ListView fx:id="goalList" minWidth="280"/>
            <StackPane minWidth="420">
                <Label fx:id="emptyDetail" styleClass="placeholder" wrapText="true"
                       text="Elige un objetivo de la lista o crea uno nuevo.&#10;Un objetivo agrupa las tareas que te acercan a él y muestra su avance."/>
                <VBox fx:id="detail" spacing="12" styleClass="form-card">
                    <HBox spacing="8" alignment="TOP_LEFT">
                        <Label fx:id="goalTitle" styleClass="title-3" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="goalStatus" styleClass="badge" minWidth="-Infinity"/>
                    </HBox>
                    <HBox fx:id="goalMeta" spacing="10" alignment="CENTER_LEFT"/>
                    <Label fx:id="goalDescription" wrapText="true" styleClass="text-muted"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ProgressBar fx:id="goalProgress" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="goalProgressText" minWidth="-Infinity"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#editGoal">
                            <graphic><FontIcon iconLiteral="mdi2p-pencil-outline"/></graphic>
                        </Button>
                        <Button fx:id="achieveButton" onAction="#toggleAchieved" styleClass="success, button-outlined"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#deleteGoal" styleClass="danger, button-outlined">
                            <graphic><FontIcon iconLiteral="mdi2d-delete-outline"/></graphic>
                        </Button>
                    </HBox>
                    <Separator/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Tareas vinculadas" styleClass="title-4"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Nueva tarea" onAction="#newTaskForGoal" styleClass="flat" minWidth="-Infinity">
                            <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
                        </Button>
                        <Button text="Vincular tareas…" onAction="#linkTasks" minWidth="-Infinity">
                            <graphic><FontIcon iconLiteral="mdi2l-link-variant"/></graphic>
                        </Button>
                    </HBox>
                    <ListView fx:id="taskList" VBox.vgrow="ALWAYS" minHeight="160"/>
                </VBox>
            </StackPane>
        </SplitPane>
    </center>
</BorderPane>

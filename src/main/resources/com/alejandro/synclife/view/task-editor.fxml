<?xml version="1.0" encoding="UTF-8"?>

<?import com.alejandro.synclife.ui.control.ChecklistEditor?>
<?import com.alejandro.synclife.ui.control.TimeField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.alejandro.synclife.controller.TaskEditorController"
      spacing="12" prefWidth="600" styleClass="task-editor">

    <Label fx:id="routineLabel" styleClass="routine-note" wrapText="true" managed="false" visible="false">
        <graphic>
            <FontIcon iconLiteral="mdi2r-repeat"/>
        </graphic>
    </Label>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Título *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" promptText="¿Qué hay que hacer?" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Descripción" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP">
            <GridPane.margin><Insets top="6"/></GridPane.margin>
        </Label>
        <TextArea fx:id="descriptionArea" promptText="Notas, enlaces, detalles…" prefRowCount="3" wrapText="true"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Área" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <ComboBox fx:id="areaCombo" prefWidth="150"/>
            <ComboBox fx:id="categoryCombo" prefWidth="220" promptText="Categoría"/>
        </HBox>

        <Label text="Prioridad" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
            <ComboBox fx:id="priorityCombo" prefWidth="150"/>
            <ComboBox fx:id="statusCombo" prefWidth="220"/>
        </HBox>

        <Label fx:id="quadrantLabel" text="Matriz" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <HBox fx:id="quadrantRow" spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <ComboBox fx:id="quadrantCombo" prefWidth="378"/>
        </HBox>

        <Label fx:id="goalLabel" text="Objetivo" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <HBox fx:id="goalRow" spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <ComboBox fx:id="goalCombo" prefWidth="378"/>
        </HBox>

        <Label text="Programada" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="6" GridPane.columnIndex="1">
            <DatePicker fx:id="scheduledPicker" promptText="Sin fecha" prefWidth="190" minWidth="-Infinity"/>
            <Label text="a las" styleClass="text-muted" minWidth="-Infinity"/>
            <TimeField fx:id="timeField" minWidth="-Infinity"/>
        </HBox>

        <Label fx:id="reminderLabel" text="Recordatorio" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <HBox fx:id="reminderRow" spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="7" GridPane.columnIndex="1">
            <ComboBox fx:id="reminderCombo" prefWidth="230" minWidth="-Infinity"/>
            <TimeField fx:id="reminderTimeField" minWidth="-Infinity"/>
            <Label fx:id="reminderHint" styleClass="text-muted, text-small" wrapText="true" minWidth="0"/>
        </HBox>

        <Label text="Duración" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="8" GridPane.columnIndex="1">
            <Spinner fx:id="estimateSpinner" editable="true" prefWidth="110" minWidth="-Infinity"/>
            <Label text="minutos (estimación)" styleClass="text-muted" minWidth="-Infinity"/>
        </HBox>

        <Label text="Fecha límite" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
        <DatePicker fx:id="duePicker" promptText="Sin fecha límite" prefWidth="210"
                    GridPane.rowIndex="9" GridPane.columnIndex="1"/>

        <Label fx:id="timeLabel" text="Tiempo real" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
        <HBox fx:id="timeRow" spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="10" GridPane.columnIndex="1">
            <Label fx:id="trackedLabel" minWidth="0">
                <graphic><FontIcon iconLiteral="mdi2c-clock-outline"/></graphic>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="pomodoroButton" text="Pomodoro" onAction="#startPomodoro" minWidth="-Infinity">
                <graphic><FontIcon iconLiteral="mdi2t-timer-outline"/></graphic>
            </Button>
            <MenuButton fx:id="timeMenu" text="Registro" minWidth="-Infinity">
                <graphic><FontIcon iconLiteral="mdi2h-history"/></graphic>
            </MenuButton>
        </HBox>
    </GridPane>

    <VBox fx:id="checklistBox" spacing="6">
        <Separator/>
        <Label fx:id="checklistTitle" text="Lista de comprobación" styleClass="title-4">
            <graphic><FontIcon iconLiteral="mdi2f-format-list-checkbox"/></graphic>
        </Label>
        <ChecklistEditor fx:id="checklistEditor"/>
    </VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de Hibernate para SyncLife.
  La URL JDBC NO está aquí a propósito: HibernateUtil la fija en tiempo de ejecución apuntando a
  ~/.synclife/synclife.db (o -Dsynclife.home). Si se olvidara, Hibernate fallaría al arrancar
  en lugar de crear en silencio una base de datos en el directorio actual.
-->
<hibernate-configuration xmlns="http://www.hibernate.org/xsd/orm/cfg">
    <session-factory>
        <!-- Conexión -->
        <property name="jakarta.persistence.jdbc.driver">org.sqlite.JDBC</property>
        <property name="hibernate.dialect">org.hibernate.community.dialect.SQLiteDialect</property>
        <!-- SQLite admite un único escritor: una conexión, usada desde un único hilo (ver FxAsync) -->
        <property name="hibernate.connection.pool_size">1</property>

        <!-- El esquema lo gestiona Flyway (src/main/resources/db/migration) -->
        <property name="hibernate.hbm2ddl.auto">none</property>
        <property name="hibernate.physical_naming_strategy">org.hibernate.boot.model.naming.PhysicalNamingStrategySnakeCaseImpl</property>

        <!-- Depuración: poner a true para ver el SQL generado -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Entidades -->
        <mapping class="com.alejandro.synclife.model.entity.Category"/>
        <mapping class="com.alejandro.synclife.model.entity.Routine"/>
        <mapping class="com.alejandro.synclife.model.entity.Task"/>
        <mapping class="com.alejandro.synclife.model.entity.Subtask"/>
        <mapping class="com.alejandro.synclife.model.entity.TimeEntry"/>
    </session-factory>
</hibernate-configuration>
